[Unit]
Description=solderscope capture service (stills, recording, web UI)
After=network-online.target mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=master
WorkingDirectory=/opt/solderscope
Environment=SOLDERSCOPE_MEDIA=/home/master/solderscope-media
Environment=SOLDERSCOPE_PORT=80
ExecStart=/usr/bin/python3 /opt/solderscope/service/solderscope.py
Restart=on-failure
RestartSec=5

# Bind port 80 without running as root.
#
# Only AmbientCapabilities is set on purpose. Restricting CapabilityBoundingSet
# to CAP_NET_BIND_SERVICE was tested on the target and breaks the sensor
# handover: the service still serves port 80, but every capture fails with
# "Pipeline handler in use by another process" because MediaMTX can no longer
# be stopped. The failure is easy to misread, since only photos break.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
