[Unit]
Description=solderscope capture service (stills, recording, web UI)
After=network-online.target mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=master
WorkingDirectory=/opt/solderscope
Environment=SOLDERSCOPE_MEDIA=/home/master/solderscope-media
Environment=SOLDERSCOPE_PORT=80
ExecStart=/usr/bin/python3 /opt/solderscope/service/solderscope.py
Restart=on-failure
RestartSec=5

# Bind port 80 without running as root.
#
# Only AmbientCapabilities is set on purpose. Restricting CapabilityBoundingSet
# to CAP_NET_BIND_SERVICE also strips CAP_SETUID/CAP_SETGID, which sudo needs --
# the service would still serve port 80 but every still capture would fail with
# "Pipeline handler in use by another process", because it could no longer stop
# MediaMTX to hand over the sensor.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
